# Database
DATABASE_URL=postgres://gallery:gallery@postgres:5432/gallery?sslmode=disable

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# Server
PORT=8080
APP_BASE_URL=http://localhost

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./data/images

# imgproxy
# Set IMGPROXY_ENABLED=true to use imgproxy for resized/WebP thumbnails.
# When false, the API serves raw original files as thumbnails (dev mode).
IMGPROXY_ENABLED=false
IMGPROXY_KEY=change_me_generate_with_openssl_rand_hex_32
IMGPROXY_SALT=change_me_generate_with_openssl_rand_hex_32
IMGPROXY_BASE_URL=http://imgproxy:8080

# S3-compatible storage (optional, set STORAGE_BACKEND=s3 to use)
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-gallery-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Admin account (optional — created automatically on startup if set)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=changeme

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
