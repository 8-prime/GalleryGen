<!DOCTYPE html>
<html lang="en">

<head>
    <title>Portfolio - @Name</title>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <link rel="stylesheet" href="style.css"/>
</head>

<body>
</body>
<LinkInfo Collections="Collections" Name="@Name"></LinkInfo>
<div class="images-container">
    <img src="@RandomImage" alt="A random image from the portfolio"/>
</div>
</html>

@code {
    [Parameter] public string Name { get; set; } = null!;
    [Parameter] public List<string> Collections { get; set; } = [];
    [Parameter] public string RandomImage { get; set; } = null!;
}